{{ header }}
<div id="common-success" class="container page-wrap">
	<div class="breadcrumbs">
		{% for breadcrumb in breadcrumbs %}
			{% if loop.last %}
				<span>{{ breadcrumb.text }}</span>
			{% else %}
				<a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
				<i>/</i>
			{% endif %}
		{% endfor %}
	</div>
	<h1 class="page-title">{{ heading_title }}</h1>
	<div class="content">
		{{ content_top }}
		{{ text_message }}
		{% if bank_transfer_info %}
			<div class="alert alert-info">
				{{ bank_transfer_info|raw }}
			</div>
		{% endif %}
		<div class="buttons">
			<a href="{{ continue }}" class="form-btn btn dif aic jcc">{{ button_continue }}</a>
		</div>
		{{ content_bottom }}
	</div>
	{{ column_left }}
        {{ column_right }}

        <div id="checkSpamModal" class="modal-overlay" style="display:none;">
                <div class="modal-window">
                        <span>{{ text_check_spam }}</span>
                </div>
        </div>
</div>

				{% if me_fb_events_status and order_id and me_fb_events_track_purchase %}
				<script>
				{% if me_fb_events_pixel_id %}
				fbq('track', 'Purchase', {
					value: {{ total }},
					currency: '{{ currency_code }}',
					contents: [
					{% set i = 0 %}
						{% for product in fbproducts %}
						{% if i > 0 %},{% endif %}
					  {
						'id': '{{ product['id'] }}',
						'quantity': {{ product['quantity'] }},
						'item_price': {{ product['price'] }}
					  }
					  {% set i = i + 1 %}
					{% endfor %}
					 ],
					content_type: 'product',
					num_items: {{ i }},
					},
				 {eventID: '{{ event_id }}'});
			     {% endif %}
			     </script>
				{% endif %}
			
{{ footer }}

<style>
.modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        display: flex;
        align-items: center;
        justify-content: center;
}

.modal-window {
        background: #fff;
        padding: 1.5rem;
        border-radius: 8px;
        max-width: 400px;
        width: 100%;
        text-align: center;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
        var overlay = document.getElementById('checkSpamModal');
        overlay.style.display = 'flex';

        overlay.addEventListener('click', function(e) {
                if (e.target === overlay) {
                        overlay.style.display = 'none';
                }
        });
});
</script>
</body></html>
